# ==========================================
# TaskFlow Docker Environment Configuration Example
# Copy this file to .env and adjust variables as needed
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://mongodb:27017/taskflow
JWT_SECRET=replace_with_secure_production_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# Frontend Configuration
VITE_API_URL=/api

# Local Port Mappings
FRONTEND_PORT=5173
BACKEND_PORT=5000
