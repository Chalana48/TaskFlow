{
  "name": "server",
  "version": "1.0.0",
  "description": "TaskFlow - Smart Project & Team Management Platform Backend REST API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --runInBand",
    "test:unit": "jest --detectOpenHandles --runInBand tests/unit",
    "test:integration": "jest --detectOpenHandles --runInBand tests/auth.test.js tests/project.test.js tests/task.test.js tests/dashboard.test.js tests/notification.test.js tests/admin.test.js",
    "test:e2e": "jest --detectOpenHandles --runInBand tests/e2e/userJourneys.test.js",
    "test:coverage": "jest --detectOpenHandles --runInBand --coverage",
    "seed": "node utils/seed.js"
  },
  "keywords": [
    "mern",
    "express",
    "mongodb",
    "jwt",
    "rbac",
    "rest-api"
  ],
  "author": "TaskFlow Engineering Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
